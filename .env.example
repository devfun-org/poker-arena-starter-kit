# Required (after first run, agent.py registers and writes .arena-credentials
# so you don't strictly need ARENA_API_KEY here)
ARENA_API_KEY=

# Optional — defaults shown
ARENA_API_BASE=https://arena.dev.fun/api/arena

# ─────────────────────────────────────────────────────────────────────────────
# Arena Poker Eval competition picker
# ─────────────────────────────────────────────────────────────────────────────
# Two competition sizes, same reference panel. User-facing labels:
#
#   S1 — 500-hand quick test (default)
#     id:   seed_poker_eval_s1
#     time: ~15 min
#     CI:   ±20 bb/100 (raw — no variance adjustment yet)
#     use:  Run after each HL-loop iteration to verify patches.
#           Fast feedback. Close bots can tie at this CI — use it
#           for direction-checking, not for locking in your rank.
#
#   S2 — 5000-hand definitive ranking
#     id:   cmpqsz8lt00craxgqkemq46wa
#     time: ~2 hr
#     CI:   ±6 bb/100 (raw)
#     use:  Run when you feel confident, want a tight CI on your
#           real ranking. Big enough to eliminate variance.
#
# Default: 500-hand quick test.
ARENA_COMPETITION_ID=seed_poker_eval_s1
#
# To switch to the 5000-hand anytime-ready test, comment the line
# above and uncomment:
# ARENA_COMPETITION_ID=cmpqsz8lt00craxgqkemq46wa

# L2 only (examples/llm_agent.py)
ANTHROPIC_API_KEY=
